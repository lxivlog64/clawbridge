WORKBUDDY_CLIENT_ID=cb_replace_me
WORKBUDDY_CLIENT_SECRET=replace_me
WORKBUDDY_REDIRECT_URI=http://127.0.0.1:43119/callback
WORKBUDDY_TOKEN_FILE=.workbuddy-bridge/tokens.json
WORKBUDDY_API_BASE_URL=https://www.workbuddy.cn/openapi/v2

# Personal-developer route: CodeBuddy Code HTTP API.
CODEBUDDY_BASE_URL=http://127.0.0.1:8080/api/v1
CODEBUDDY_GATEWAY_TOKEN=replace_with_the_password_printed_by_codebuddy_serve

# Cloud control plane (VPS only). Keep all real values outside this repository.
CLAWBRIDGE_CLOUD_LISTEN_HOST=127.0.0.1
CLAWBRIDGE_CLOUD_PORT=43120
CLAWBRIDGE_CLOUD_API_TOKEN=replace_with_a_long_random_client_token
# Example only; use a distinct token for every Worker.
CLAWBRIDGE_CLOUD_WORKER_TOKENS_JSON={"linux-dev":"replace_with_a_long_random_worker_token"}

# Private Worker only. The Worker connects outward to the VPS; do not expose CodeBuddy's port.
CLAWBRIDGE_CLOUD_CONTROL_URL=https://clawbridge.example.com
CLAWBRIDGE_CLOUD_WORKER_ID=linux-dev
CLAWBRIDGE_CLOUD_WORKER_TOKEN=replace_with_that_workers_token
CLAWBRIDGE_CLOUD_WORKER_POLL_MS=10000
